FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app/backend
# PDF templates need a font with Romanian diacritics.
RUN apt-get update && apt-get install -y --no-install-recommends fonts-dejavu-core && rm -rf /var/lib/apt/lists/*
COPY backend/requirements.lock ./requirements.lock
RUN pip install --no-cache-dir --require-hashes -r requirements.lock
COPY backend/ ./
COPY data/ /app/data/
ENV AERODESK_CORPUS_DIR=/app/data AERODESK_STORAGE_DIR=/state/storage AERODESK_DATABASE_URL=sqlite:////state/aerodesk.db
RUN useradd --uid 10001 --create-home aerodesk && mkdir -p /state && chown aerodesk:aerodesk /state
USER aerodesk
EXPOSE 8000
CMD ["sh", "-c", "python -m alembic upgrade head && python -m uvicorn app.main:app --host 0.0.0.0 --port 8000 --no-access-log"]
