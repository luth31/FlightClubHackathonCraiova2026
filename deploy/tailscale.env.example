# Copy to .env.tailscale. Only the opt-in presentation deployment reads it.
# Keep the root .env and the standard dev/start-demo commands unchanged.
FLYLEAF_CRAIOVA_PUBLIC_URL=https://aeroport-craiova.taileceb7a.ts.net
FLYLEAF_SIBIU_PUBLIC_URL=https://aeroport-sibiu.taileceb7a.ts.net
# GOOGLE_MAPS_API_KEY is inherited from the root .env by default, in both modes.
# To use a DIFFERENT presentation key, uncomment and set the override below.
# An explicitly blank override disables Google only in the presentation stack.
# GOOGLE_MAPS_API_KEY=your-presentation-browser-key
