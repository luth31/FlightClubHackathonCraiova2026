# Copy to .env in the repository root. Keep the real key out of Git.
OPENAI_API_KEY=
FLYLEAF_OPENAI_MODEL=gpt-6-luna
# Optional per-task override. Blank uses FLYLEAF_OPENAI_MODEL.
FLYLEAF_OPENAI_REDACTION_MODEL=

# Optional Google Map Tiles browser key, shared by local and presentation modes.
# Restrict to Map Tiles API and the localhost/Tailscale web origins you use.
# Without a key, both modes retain the bundled airport model.
GOOGLE_MAPS_API_KEY=

# Backend-only employee provisioning clients. Compose uses fictional demo
# secrets when blank; configure unique secrets for a real installation.
FLYLEAF_CRAIOVA_PROVISIONING_SECRET=
FLYLEAF_SIBIU_PROVISIONING_SECRET=
# Set true only after configuring SMTP in both airport realms.
FLYLEAF_KEYCLOAK_ACTIVATION_EMAIL=false
# Local OIDC development (outside Compose) also needs:
# FLYLEAF_KEYCLOAK_PROVISIONING_CLIENT_SECRET=<matching realm client secret>
