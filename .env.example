# Copy to .env in the repository root. Keep the real key out of Git.
OPENAI_API_KEY=
AERODESK_OPENAI_MODEL=gpt-6-luna
# Optional per-task override. Blank uses AERODESK_OPENAI_MODEL.
AERODESK_OPENAI_REDACTION_MODEL=

# Backend-only employee provisioning clients. Compose uses fictional demo
# secrets when blank; configure unique secrets for a real installation.
AERODESK_DUNAREA_PROVISIONING_SECRET=
AERODESK_CARPATI_PROVISIONING_SECRET=
# Set true only after configuring SMTP in both airport realms.
AERODESK_KEYCLOAK_ACTIVATION_EMAIL=false
# Local OIDC development (outside Compose) also needs:
# AERODESK_KEYCLOAK_PROVISIONING_CLIENT_SECRET=<matching realm client secret>
